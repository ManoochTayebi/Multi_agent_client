# demo = deterministic, no external calls. llm = real model routing/planning/synthesis/judge
ATLAS_MODE=demo
DATABASE_URL=sqlite:///runtime/atlas.db
CHROMA_PATH=runtime/chroma
DATA_DIR=data
# Fixed synthetic business clock. Changing it changes return eligibility.
AS_OF_DATE=2026-10-26
# In demo mode the server issues sessions only for synthetic customers.
DEMO_ACCESS=true
# Required for /admin routes. Replace before exposing any deployment.
ADMIN_API_KEY=replace-with-a-long-random-value
# Required when DEMO_ACCESS=false: maps trusted credentials to customer IDs.
# JSON: {"secret-token-1":"C0001"}
CUSTOMER_TOKENS={}
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# optional: semantic embeddings; blank uses reproducible lexical hash embeddings
EMBEDDING_MODEL=
# optional carrier adapter; no real carrier is contacted by default
CARRIER_BASE_URL=
CARRIER_API_KEY=
# Docker Compose only:
POSTGRES_PASSWORD=replace-with-a-second-long-random-value
