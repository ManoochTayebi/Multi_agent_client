# Create the local model first: ollama create atlas-local -f models/Modelfile
ATLAS_MODE=llm
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=atlas-local
EMBEDDING_MODEL=all-minilm
LLM_TOKEN_PARAMETER=max_tokens
LLM_REASONING_EFFORT=none
LLM_JSON_SCHEMA=true
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0
# Provider inference charges only. Excludes electricity, hardware, embedding and operator costs.
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
DATABASE_URL=sqlite:///runtime/atlas.db
CHROMA_PATH=runtime/chroma
DATA_DIR=data
AS_OF_DATE=2026-10-26
DEMO_ACCESS=true
ADMIN_API_KEY=replace-with-a-long-random-value
